{
  "name": "pkpilot0013-visna-sol",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HD2Lab Vísna Sól — an in-browser Git, Python, Linux and SQL learning sandbox",
  "scripts": {
    "dev": "vite",
    "build": "node tools/sync-sqljs.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "brand": "python3 tools/generate_brand_assets.py",
    "sync:sqljs": "node tools/sync-sqljs.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
